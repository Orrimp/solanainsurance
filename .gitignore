/target

# macOS cruft
.DS_Store

# Solana local validator (ledger) outputs
/test-ledger/
/snapshot/

# Limit noisy artifacts within test-ledger
/test-ledger/**/*.log
/test-ledger/**/*.bin
/test-ledger/**/*.sst
/test-ledger/rocksdb/
/test-ledger/accounts/

# Additional local validator outputs
/.validator-ledger/
/.validator-ledger-verbose/

# Local scratch/test directories
/.link-test/
/.symlink-test/
